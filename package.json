{
  "name": "contrast-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "草楷对比阅读器：导入 EPUB，正文以系统草书字体呈现，点按段落切换楷书对照，帮助学会认草书。",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "icons": "node scripts/gen-icons.mjs",
    "sample": "node scripts/make-sample-epub.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lxgw-wenkai-webfont": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.0",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
